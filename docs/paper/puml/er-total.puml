@startuml 系统总体ER图
' 图4-20 系统总体E-R图（完整9实体版）

skinparam linetype ortho
skinparam entity {
    BackgroundColor #FEFECE
    BorderColor #A80036
    FontSize 12
}

entity "用户" as user {
    * **id** : bigint <<PK>>
    --
    username : varchar(64)
    password : varchar(128)
    nickname : varchar(64)
    avatar : varchar(255)
    phone : varchar(20)
    gender : varchar(8)
    age : int
    role : varchar(16)
    status : varchar(16)
    create_time : datetime
    update_time : datetime
    is_delete : tinyint
}

entity "教练认证" as coach_cert {
    * **id** : bigint <<PK>>
    --
    * //user_id// : bigint <<FK>>
    real_name : varchar(64)
    cert_type : varchar(64)
    cert_no : varchar(128)
    expertise : varchar(255)
    cert_image : varchar(255)
    status : varchar(16)
    reject_reason : text
    create_time : datetime
    update_time : datetime
}

entity "健康记录" as health_record {
    * **id** : bigint <<PK>>
    --
    * //user_id// : bigint <<FK>>
    record_date : date
    weight_kg : decimal(5,2)
    body_fat_pct : decimal(4,2)
    calorie_intake : int
    calorie_burn : int
    sleep_hours : decimal(3,1)
    notes : text
    create_time : datetime
}

entity "健康问卷" as questionnaire {
    * **id** : bigint <<PK>>
    --
    * //user_id// : bigint <<FK>>
    goal_type : varchar(32)
    height_cm : int
    current_weight_kg : decimal(5,2)
    target_weight_kg : decimal(5,2)
    goal_cycle_days : int
    sport_base : varchar(32)
    diet_preference : varchar(64)
    health_issues : text
    create_time : datetime
}

entity "个性化方案" as plan {
    * **id** : bigint <<PK>>
    --
    * //user_id// : bigint <<FK>>
    //questionnaire_id// : bigint <<FK>>
    plan_type : varchar(32)
    bmr : decimal(8,2)
    daily_calorie_target : int
    diet_suggestion : text
    workout_suggestion : text
    valid_days : int
    status : varchar(16)
    create_time : datetime
}

entity "社区动态" as community {
    * **id** : bigint <<PK>>
    --
    * //user_id// : bigint <<FK>>
    title : varchar(255)
    content : text
    category : varchar(64)
    image_urls : json
    like_count : int
    comment_count : int
    status : varchar(16)
    create_time : datetime
}

entity "积分账户" as points {
    * **id** : bigint <<PK>>
    --
    * //user_id// : bigint <<FK>> <<UK>>
    total_point : int
    available_point : int
    level_name : varchar(32)
    create_time : datetime
    update_time : datetime
    is_delete : tinyint
}

entity "在线咨询" as consult {
    * **id** : bigint <<PK>>
    --
    * //user_id// : bigint <<FK>>
    //coach_user_id// : bigint <<FK>>
    question : text
    reply : text
    status : varchar(16)
    create_time : datetime
    reply_time : datetime
}

entity "推荐内容" as recommend {
    * **id** : bigint <<PK>>
    --
    title : varchar(255)
    summary : varchar(500)
    content : text
    category : varchar(64)
    cover_image : varchar(255)
    solar_term : varchar(32)
    status : varchar(16)
    view_count : int
    create_time : datetime
}

' ===== 联系关系 =====
user ||--o{ health_record : "记录\n1:N"
user ||--o{ questionnaire : "填写\n1:N"
user ||--o{ plan : "拥有\n1:N"
user ||--o{ community : "发布\n1:N"
user ||--|| points : "对应\n1:1"
user ||--o{ consult : "提交\n1:N"
user ||--o{ coach_cert : "申请\n1:N"
user ||--o{ consult : "回复\n1:N"
questionnaire ||--o{ plan : "生成\n1:N"

note bottom of recommend
  推荐内容由管理员
  统一管理和发布，
  不直接关联用户表
end note

@enduml
