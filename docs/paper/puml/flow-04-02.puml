@startuml 登录注册模块流程图
' 图4-2 登录注册模块流程图（用户）

skinparam ActivityBackgroundColor white
skinparam ActivityBorderColor black
skinparam ArrowColor black
skinparam DiamondBackgroundColor white
skinparam DiamondBorderColor black

start
:打开小程序，进入登录/注册页面;
if (选择操作?) then (登录)
  :输入账号和密码，提交登录;
  if (验证通过?) then (是)
    :登录成功，跳转首页;
  else (否)
    :提示错误信息;
  endif
else (注册)
  :输入账号、密码、手机号，提交注册;
  if (校验通过且账号不存在?) then (是)
    :密码加密存储，注册成功;
  else (否)
    :提示注册失败原因;
  endif
endif
stop

@enduml
